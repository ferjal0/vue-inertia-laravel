{
    "name": "vue-inertia-laravel-starter",
    "version": "0.1.0",
    "description": "The Vue Inertia Laravel Starter",
    "keywords": [
        "laravel",
        "inertia",
        "vue",
        "tailwind",
        "shadcn-ui"
    ],
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc && vite build && vite build --ssr",
        "dev": "vite",
        "lint": "eslint resources/js --ext .js,.ts,.vue --ignore-path .gitignore --fix",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-vue-next": "^1.0.0",
        "radix-vue": "^1.9.17",
        "tailwind-merge": "^3.6.0",
        "tailwindcss-animate": "^1.0.7",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@iconify-json/radix-icons": "^1.2.6",
        "@iconify/vue": "^5.0.1",
        "@inertiajs/vue3": "^3.7.0",
        "@rushstack/eslint-patch": "^1.16.1",
        "@tailwindcss/forms": "^0.5.11",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/server-renderer": "^3.5.42",
        "autoprefixer": "^10.5.6",
        "axios": "^1.20.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-plugin-vue": "^10.11.0",
        "laravel-vite-plugin": "^3.2.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^8.3.0",
        "vue": "^3.5.42",
        "vue-tsc": "^3.3.11"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "vue-demi"
        ]
    }
}
